<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>$(CI)</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591;CA1707</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1510;NU1504;SYSLIB0060;CS0105;CS0108;IL2026;IL3050;NU1903;NU1605</NoWarn>
  </PropertyGroup>
</Project>
