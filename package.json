{
  "name": "l4h-multilingual-testing",
  "version": "1.0.0",
  "description": "Comprehensive multilingual e2e testing for L4H platform",
  "scripts": {
    "test:multilingual": "node tests/ui.e2e/run-multilingual-tests.ts",
    "test:multilingual:quick": "node tests/ui.e2e/run-multilingual-tests.ts --languages en-US,es-ES,ar-SA",
    "test:multilingual:rtl": "node tests/ui.e2e/run-multilingual-tests.ts --languages ar-SA,ur-PK --browsers 'RTL Testing - Arabic'",
    "test:multilingual:cjk": "node tests/ui.e2e/run-multilingual-tests.ts --languages zh-CN,ja-JP --browsers 'CJK Testing - Chinese'",
    "test:multilingual:comprehensive": "node tests/ui.e2e/run-multilingual-tests.ts --languages en-US,es-ES,fr-FR,de-DE,ar-SA,zh-CN,hi-IN,ja-JP,ur-PK,ru-RU",
    "test:multilingual:debug": "node tests/ui.e2e/run-multilingual-tests.ts --debug --headless false --verbose",
    "test:multilingual:ci": "node tests/ui.e2e/run-multilingual-tests.ts --languages en-US,es-ES,ar-SA --reporter junit --parallel false",
    "test:multilingual:performance": "node tests/ui.e2e/run-multilingual-tests.ts --languages en-US,es-ES,ar-SA,zh-CN --verbose --timeout 120000",
    "playwright:install": "npx playwright install",
    "playwright:install-deps": "npx playwright install-deps"
  },
  "dependencies": {
    "@playwright/test": "^1.56.0",
    "axios": "^1.12.2",
    "mssql": "^11.0.1",
    "node-fetch": "^2.7.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "puppeteer": "^24.22.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "e2e-testing",
    "multilingual",
    "internationalization",
    "i18n",
    "playwright",
    "accessibility",
    "rtl-support"
  ]
}
