# Build stage
FROM node:20-alpine AS build
WORKDIR /app

# Copy shared-ui first
COPY web/shared-ui ./web/shared-ui
WORKDIR /app/web/shared-ui
RUN npm ci
RUN npm run build

# Build l4h
WORKDIR /app/web/l4h
COPY web/l4h/package*.json ./
RUN npm ci
COPY web/l4h .
RUN npm run build

# Build cannlaw
WORKDIR /app/web/cannlaw
COPY web/cannlaw/package*.json ./
RUN npm ci
COPY web/cannlaw .
RUN npm run build

# Production stage
FROM nginx:1.27-alpine
RUN rm /etc/nginx/conf.d/default.conf

# Copy build artifacts from build stage
COPY --from=build /app/web/l4h/dist /usr/share/nginx/html/l4h
COPY --from=build /app/web/cannlaw/dist /usr/share/nginx/html/cannlaw

# Copy nginx configuration
COPY ops/k8s/base/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]