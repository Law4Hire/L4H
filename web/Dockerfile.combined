FROM nginx:1.27-alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy build artifacts from the host (runner)
# These must be built before running docker build
COPY web/l4h/dist /usr/share/nginx/html/l4h
COPY web/cannlaw/dist /usr/share/nginx/html/cannlaw

# Copy nginx configuration
# We'll use a local copy of the config from the ConfigMap
COPY ops/k8s/base/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
