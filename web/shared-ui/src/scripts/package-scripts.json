{
  "scripts": {
    "translation:add-language": "node web/shared-ui/src/scripts/add-new-language.ts",
    "translation:update-shared": "node web/shared-ui/src/scripts/update-shared-translations.ts",
    "translation:migrate-keys": "node web/shared-ui/src/scripts/translation-key-migrator.ts",
    "translation:validate": "node web/shared-ui/src/scripts/run-translation-validation.ts",
    "translation:manager": "node web/shared-ui/src/scripts/translation-manager.ts",
    "translation:completeness": "node web/shared-ui/src/scripts/translation-completeness-validator.ts",
    "translation:consistency": "node web/shared-ui/src/scripts/translation-consistency-checker.ts",
    "translation:interpolation": "node web/shared-ui/src/scripts/interpolation-validator.ts"
  },
  "description": "Translation management scripts for the L4H platform",
  "usage": {
    "add-language": {
      "description": "Add a new language to all applications",
      "examples": [
        "npm run translation:add-language add zh-TW",
        "npm run translation:add-language add zh-TW --placeholders",
        "npm run translation:add-language list"
      ]
    },
    "update-shared": {
      "description": "Update shared translations across applications",
      "examples": [
        "npm run translation:update-shared update common loading 'Loading...'",
        "npm run translation:update-shared sync common",
        "npm run translation:update-shared bulk updates.json"
      ]
    },
    "migrate-keys": {
      "description": "Migrate translation keys across applications",
      "examples": [
        "npm run translation:migrate-keys migrate old.key new.key common",
        "npm run translation:migrate-keys bulk migrations.json",
        "npm run translation:migrate-keys analyze common.loading"
      ]
    },
    "manager": {
      "description": "Comprehensive translation management tool",
      "examples": [
        "npm run translation:manager add-language zh-TW",
        "npm run translation:manager validate",
        "npm run translation:manager report",
        "npm run translation:manager sync common,errors"
      ]
    },
    "validate": {
      "description": "Run comprehensive translation validation",
      "examples": [
        "npm run translation:validate",
        "npm run translation:validate --language es-ES",
        "npm run translation:validate --namespace common"
      ]
    }
  }
}