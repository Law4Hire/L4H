import i18n from 'i18next';
import { initReactI18next } from 'react-i18next';
import HttpApi from 'i18next-http-backend';

// RTL languages that should flip layout - EMPTY FOR ENGLISH ONLY
const RTL_LANGUAGES: string[] = [];

// Initialize i18next
i18n
  .use(HttpApi)
  .use(initReactI18next)
  .init({
    lng: 'en-US',
    fallbackLng: 'en-US',
    ns: ['common'],
    defaultNS: 'common',
    interpolation: {
      escapeValue: false,
    },
    backend: {
      // Point to a non-existent path or a simple static path if needed, 
      // but effectively we only care about en-US.
      // If l4h uses these files, we need to make sure en-US exists.
      loadPath: '/locales-new/{{lng}}/{{ns}}.json',
    },
  });

export default i18n;

// Culture interface for API responses
export interface Culture {
  code: string;
  displayName: string;
}

// Load supported cultures from API - ONLY ENGLISH
export async function loadSupportedCultures(): Promise<Culture[]> {
  return [
    { code: 'en-US', displayName: 'English' },
  ];
}

// Set culture via API - NO-OP (Enforce English)
export async function setCulture(cultureCode: string): Promise<void> {
  console.warn('Localization disabled. Only English is supported.');
  // Force English
  await i18n.changeLanguage('en-US');
  setRTLDirection('en-US');
}

// Set RTL direction based on language - NO-OP (Enforce LTR)
export function setRTLDirection(languageCode: string): void {
  const htmlElement = document.documentElement;
  
  // Force LTR
  htmlElement.setAttribute('dir', 'ltr');
  htmlElement.setAttribute('lang', 'en-US');
}

// Check if current language is RTL - ALWAYS FALSE
export function isRTL(): boolean {
  return false;
}