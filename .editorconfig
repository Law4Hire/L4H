root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,vb}]
indent_style = space
indent_size = 4

# C# Code Style Rules
[*.cs]

# Culture-aware formatting
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1304.severity = warning

# Dispose patterns
# CA2007: ConfigureAwait - Not required for ASP.NET Core (no SynchronizationContext)
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1063.severity = error
dotnet_diagnostic.CA1816.severity = error

# Cancellation token flow
dotnet_diagnostic.CA2016.severity = error

# Async/await patterns
dotnet_diagnostic.CA2012.severity = error

# Security
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5351.severity = error

# Performance
dotnet_diagnostic.CA1829.severity = error

# Naming conventions
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1708.severity = error
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1711.severity = none

# Design Rules
dotnet_diagnostic.CA1002.severity = warning
dotnet_diagnostic.CA2227.severity = warning
dotnet_diagnostic.CA1056.severity = warning
dotnet_diagnostic.CA1008.severity = warning
dotnet_diagnostic.CA1062.severity = warning
dotnet_diagnostic.CA1031.severity = warning
dotnet_diagnostic.CA1054.severity = warning
dotnet_diagnostic.CA1819.severity = warning
dotnet_diagnostic.CA2234.severity = warning
dotnet_diagnostic.CA1018.severity = warning
dotnet_diagnostic.CA1813.severity = warning

# Maintainability Rules
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1823.severity = none

# Performance Rules
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1860.severity = none
dotnet_diagnostic.CA1854.severity = none
dotnet_diagnostic.CA1869.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1850.severity = none
dotnet_diagnostic.CA1862.severity = none
dotnet_diagnostic.CA1845.severity = none
dotnet_diagnostic.CA1849.severity = none

# Globalization/Localization Rules
dotnet_diagnostic.CA1303.severity = warning
dotnet_diagnostic.CA1308.severity = warning
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA1311.severity = warning

# Logging
dotnet_diagnostic.CA2254.severity = none

# Reliability
dotnet_diagnostic.CA2000.severity = warning

# Security
dotnet_diagnostic.CA5394.severity = warning

# Documentation
dotnet_diagnostic.CS1591.severity = none

# Test-specific rules
[**/tests/**/*.cs]
# Suppress xUnit ConfigureAwait warnings in test methods
dotnet_diagnostic.xUnit1030.severity = none
# Suppress xUnit Assert.False(true) warnings in test methods  
dotnet_diagnostic.xUnit2020.severity = none

[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false