# Top-level .editorconfig file

root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
# Suppress CA1062: Validate arguments of public methods
dotnet_diagnostic.CA1062.severity = none

# Suppress CA2227: Collection properties should be read only
dotnet_diagnostic.CA2227.severity = none

# Suppress CA1002: Do not expose generic lists
dotnet_diagnostic.CA1002.severity = none

# Suppress CA1303: Do not pass literals as localized parameters
dotnet_diagnostic.CA1303.severity = none

# Suppress CA1056: Uri properties should not be strings
dotnet_diagnostic.CA1056.severity = none

# Suppress CA1819: Properties should not return arrays
dotnet_diagnostic.CA1819.severity = none

# Suppress CA5394: Insecure randomness (mostly in seeders)
dotnet_diagnostic.CA5394.severity = none

# Suppress CA1031: Do not catch general exception types (Review later, but suppress noisy warnings for now)
# dotnet_diagnostic.CA1031.severity = none # Keeping this active as it finds real bugs

# Suppress CS8618: Non-nullable field must contain a non-null value when exiting constructor
dotnet_diagnostic.CS8618.severity = none

# --- Security Rules ---
# CA5350: Do Not Use Weak Cryptographic Algorithms
dotnet_diagnostic.CA5350.severity = error
# CA5351: Do Not Use Broken Cryptographic Algorithms
dotnet_diagnostic.CA5351.severity = error

# --- Performance Rules ---
# CA1822: Mark members as static (noisy) should be none
dotnet_diagnostic.CA1822.severity = none
# CA1829: Use Length/Count property instead of Count() when available
dotnet_diagnostic.CA1829.severity = error

# --- Globalization Rules ---
# CA1305: Specify IFormatProvider
dotnet_diagnostic.CA1305.severity = warning

# --- Reliability Rules ---
# CA2016: Forward CancellationToken to asynchronous methods
dotnet_diagnostic.CA2016.severity = error
